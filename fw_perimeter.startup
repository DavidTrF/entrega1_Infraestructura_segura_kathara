ip addr add 203.0.113.1/24 dev eth0
ip addr add 172.16.10.1/24 dev eth1
ip addr add 192.168.100.1/30 dev eth2
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up

ip route add 172.16.20.0/24 via 192.168.100.2
ip route add 172.16.25.0/24 via 192.168.100.2

iptables -P INPUT DROP
iptables -P FORWARD DROP
iptables -P OUTPUT ACCEPT

iptables -A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
iptables -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# Permitir HTTP y HTTPS hacia la DMZ
iptables -A FORWARD -i eth0 -o eth1 -d 172.16.10.10 -p tcp --dport 80 -j ACCEPT
iptables -A FORWARD -i eth0 -o eth1 -d 172.16.10.10 -p tcp --dport 443 -j ACCEPT

# Permitir ping para pruebas de conectividad
iptables -A FORWARD -p icmp -j ACCEPT
