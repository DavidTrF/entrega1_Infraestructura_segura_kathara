ip addr add 192.168.100.6/30 dev eth0
ip addr add 172.16.20.1/24 dev eth1
ip addr add 172.16.25.1/24 dev eth2
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up

ip route add default via 192.168.100.5

iptables -P INPUT DROP
iptables -P FORWARD DROP
iptables -P OUTPUT ACCEPT

iptables -A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# Permitir exclusivamente al Servidor Web consultar PostgreSQL (5432) en la BD
iptables -A FORWARD -s 172.16.10.10 -d 172.16.20.10 -p tcp --dport 5432 -j ACCEPT

# Replicacion continua hacia el Mirror
iptables -A FORWARD -s 172.16.20.10 -d 172.16.20.11 -p tcp --dport 5432 -j ACCEPT

# Backup en modo PULL hacia la BD
iptables -A FORWARD -s 172.16.25.10 -d 172.16.20.10 -p tcp --dport 22 -j ACCEPT

# Log de intentos denegados
iptables -A FORWARD -j LOG --log-prefix "[FW-INT-DROP]: "
